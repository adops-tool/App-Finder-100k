.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Streamlit ---
.streamlit/secrets.toml

# --- Editors / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db
